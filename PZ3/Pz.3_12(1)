#1. Даны 3 целых числа: А, В, С. Проверить истинность высказывания: "Каждое из чисел А, В, С положительное"

    #Задание 1
while True:
    try:
        a = int(input("Введите число A: "))
        b = int(input("Введите число B: "))
        c = int(input("Введите число C: "))
        break  # если все три числа введены корректно — выходим из цикла
    except ValueError:
        print("Ошибка: нужно вводить целое число. Попробуйте ещё раз.")

if a > 0 and b > 0 and c > 0:
    print("Высказывание истинно: каждое из чисел A, B, C положительное")
else:
    print("Высказывание ложно: не все числа положительные")
