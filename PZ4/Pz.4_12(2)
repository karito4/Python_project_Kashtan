# Дано целое число N (>1). Вывести наибольшее из целых чисел K, для которых сумма 1+2+...+K будет меньше или равна N, и саму эту сумму

n = input("Введите число N (> 1): ")
while type(n) != int:  # обработка исключений
    try:
        n = int(n)
    except ValueError:
        print("Неправильно ввели!")
        n = input("Введите число N (> 1): ")

k = 0
s = 0
while s + (k + 1) <= n:  # проверяем, поместится ли следующее слагаемое
    k += 1               # если да — берём его
    s += k               # и прибавляем к сумме

print("Наибольшее K:", k)
print("Сумма 1 + 2 + ... + K =", s)
