#1. Дано число N (>0). Найти значения выражения 1.1-1.2+1.3-... (N слагаемых, знаки чередуются). Условный оператор не использовать.

n = input("Введите количество слагаемых N: ")
while type(n) != int:  # обработка исключений
    try:
        n = int(n)
    except ValueError:
        print("Неправильно ввели!")
        n = input("Введите число: ")


s = 0
slagaemoe = 1.1
sign = 1
i = 1
while i <= n:
    s += slagaemoe * sign  # очередное слагаемое с учётом знака
    sign *= -1             # чередование знака без условного оператора
    slagaemoe += 0.1       # следующее слагаемое: 1.1, 1.2, 1.3 ...
    i += 1

print("Значение выражения:", s)
